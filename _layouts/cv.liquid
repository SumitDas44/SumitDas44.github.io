
---
layout: default
---

<!-- CV-specific styling -->
<style>
  /* Remove unwanted outer CV bullets */
  .cv ul.list-group {
    list-style: none !important;
    padding-left: 0 !important;
    margin: 0 !important;
  }

  .cv ul.list-group > li.list-group-item {
    list-style: none !important;
    display: block;
    position: relative;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .cv ul.list-group > li.list-group-item::marker {
    content: "" !important;
  }

  .cv ul.list-group-flush > li.list-group-item:last-child {
    border-bottom: 0;
  }
</style>

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <h1 class="post-title">{{ page.title }}</h1>
    <p>CV rendering is unavailable.</p>
  </div>
{% endif %}
